{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "docker:dev": "docker compose -f docker-compose.dev.yml --env-file .env.dev up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml --env-file .env.dev up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml --env-file .env.prod up",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml --env-file .env.prod build --no-cache && docker compose -f docker-compose.prod.yml --env-file .env.prod up",
    "docker:migrate:prod": "docker compose -f docker-compose.prod.yml --env-file .env.prod run --rm migrator",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky install || true",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/ormconfig.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/ormconfig.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/ormconfig.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/ormconfig.ts",
    "seed": "ts-node -P tsconfig.json src/seed-main.ts",
    "schema:drop": "typeorm-ts-node-commonjs schema:drop -d src/ormconfig.ts",
    "meili:clear": "ts-node src/search/clear-meili.ts",
    "seed:fresh": "npm run schema:drop && npm run migration:run && npm run meili:clear && npm run seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:verbose": "jest --verbose",
    "test:module": "jest --testPathPattern",
    "test:file": "jest --testPathPattern"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.19",
    "@socket.io/redis-adapter": "^8.3.0",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bloomfilter": "^0.0.15",
    "bullmq": "^5.72.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "ffmpeg-ffprobe": "^7.1.0-rc1",
    "firebase-admin": "^13.7.0",
    "fluent-ffmpeg": "^2.1.3",
    "geoip-lite": "^1.4.10",
    "handlebars": "^4.7.8",
    "ioredis": "^5.10.1",
    "meilisearch": "^0.57.0",
    "multer": "^2.1.1",
    "nest": "^0.1.6",
    "nodemailer": "^8.0.2",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.19.0",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "typeorm-extension": "^3.9.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.16",
    "@types/bcrypt": "^6.0.0",
    "@types/bloomfilter": "^0.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.16.0",
    "@types/redis": "^4.0.11",
    "@types/socket.io": "^3.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(bloomfilter|meilisearch)/)"
    ],
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.repository.ts",
      "!**/*.repositry.ts",
      "!**/*.entity.ts",
      "!**/*.dto.ts",
      "!**/*.module.ts",
      "!**/*.decorator.ts",
      "!**/*.guard.ts",
      "!**/*.strategy.ts",
      "!**/*.mock.ts",
      "!**/main.ts",
      "!**/seed-main.ts",
      "!**/*.type.ts",
      "!**/*.interface.ts",
      "!**/database/**",
      "!**/redis/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "\\.module\\.ts$",
      "main\\.ts$",
      "seed-main\\.ts$",
      "\\.dto\\.ts$",
      "\\.entity\\.ts$",
      "\\.type\\.ts$",
      "\\.filter\\.ts$"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "coverageProvider": "v8",
    "maxWorkers": 2,
    "moduleNameMapper": {
      "@ffprobe-installer/ffprobe": "<rootDir>/src/__mocks__/@ffprobe-installer/ffprobe.js"
    }
  }
}
